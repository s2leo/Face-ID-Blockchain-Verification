# =============================================================================
# Phase 1: Reverse Image Search — API Keys
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# You only need ONE provider to pass Phase 1 derisking.
# Recommended: SerpApi (free 100 searches, no credit card)
# =============================================================================

# --- Primary: SerpApi (Google Lens) ---
# Sign up free: https://serpapi.com/users/sign_up
# Get key:      https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Secondary: Google Cloud Vision ---
# Enable API:   https://console.cloud.google.com/apis/library/vision.googleapis.com
# Create SA:    https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON key and set path below
GOOGLE_APPLICATION_CREDENTIALS=

# --- Tertiary: Bing Visual Search ---
# Azure portal: https://portal.azure.com/#create/Microsoft.BingSearch
BING_SEARCH_API_KEY=

