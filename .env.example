# =============================================================================
# HH Goa 2026 — Task #3: Face ID + Blockchain Pipeline
# API Keys Configuration
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Minimum to run the pipeline:  SERPAPI_API_KEY
# Best non-famous detection:    SERPAPI_API_KEY + GEMINI_API_KEY
# =============================================================================


# -----------------------------------------------------------------------------
# PRIMARY: SerpApi — powers Google Lens AND Yandex (same key, no extra cost)
# -----------------------------------------------------------------------------
# Sign up free:  https://serpapi.com/users/sign_up
# Get key:       https://serpapi.com/manage-api-key
# Free tier:     100 searches/month, no credit card required
# Covers:        --provider serpapi  (Google Lens)
#                --provider yandex   (Yandex reverse image — same key!)
SERPAPI_API_KEY=


# -----------------------------------------------------------------------------
# GEMINI: Vision analysis for non-famous person identification (Step 1.5)
# -----------------------------------------------------------------------------
# What it does: reads visible text (badges, nametags, logos), identifies public
#               figures, generates targeted search queries from image context.
#               Critical for non-famous people who won't show up in image search.
# Get free key:  https://aistudio.google.com -> "Get API Key" (30 seconds, no card)
# Free tier:     15 requests/minute, 1000 requests/day
# Model used:    gemini-2.0-flash
# Skip with:     --no-gemini flag if you want to run without it
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# FACE-SPECIFIC: FaceCheck.id — purpose-built face search for non-famous people
# -----------------------------------------------------------------------------
# Sign up:       https://facecheck.id
# Get token:     Account settings -> API token
# Pricing:       3 credits/search @ ~$0.10/credit (paid via crypto)
# Testing mode:  FACECHECK_TESTING_MODE=true  -> free, small index (~100k faces)
#                FACECHECK_TESTING_MODE=false -> full index (~billions of faces)
FACECHECK_API_TOKEN=
FACECHECK_TESTING_MODE=true


# -----------------------------------------------------------------------------
# OPTIONAL: Google Cloud Vision WEB_DETECTION
# -----------------------------------------------------------------------------
# Enable API:    https://console.cloud.google.com/apis/library/vision.googleapis.com
# Create SA:     https://console.cloud.google.com/iam-admin/serviceaccounts
# Free tier:     1,000 units/month
GOOGLE_APPLICATION_CREDENTIALS=


# -----------------------------------------------------------------------------
# OPTIONAL: Bing Visual Search (Microsoft Azure)
# -----------------------------------------------------------------------------
# Azure portal:  https://portal.azure.com/#create/Microsoft.BingSearch
BING_SEARCH_API_KEY=


# -----------------------------------------------------------------------------
# BLOCKCHAIN: Polygon Amoy testnet
# -----------------------------------------------------------------------------
# Use a throwaway wallet funded only with Amoy test POL. Never commit a real
# private key or fund a production wallet for this demo.
AMOY_RPC_URL=https://polygon-amoy.drpc.org
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# Local demo ledger (used by default; no wallet or RPC required)
LOCAL_CHAIN_PATH=chain.json
